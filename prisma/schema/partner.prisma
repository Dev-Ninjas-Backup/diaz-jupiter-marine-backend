model Partner {
  id          String   @id @default(uuid())
  site        SiteType @default(JUPITER)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  link        String?  @db.Text
  
  logoId      String?  @unique
  logo        FileInstance? @relation("PartnerLogo", fields: [logoId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partners")
}
